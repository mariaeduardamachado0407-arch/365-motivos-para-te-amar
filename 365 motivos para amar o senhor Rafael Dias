<!DOCTYPE html><html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Motivos que te amo e que é minha pessoa</title>
  <style>
    body {
      margin: 0;
      font-family: 'Georgia', serif;
      background: linear-gradient(135deg, #0b3c5d, #123c69);
      color: #d4af37;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .container {
      background: rgba(11, 60, 93, 0.9);
      border-radius: 20px;
      padding: 30px;
      max-width: 900px;
      width: 100%;
      box-shadow: 0 0 30px rgba(212, 175, 55, 0.3);
    }
    h1 {
      text-align: center;
      margin-bottom: 10px;
    }
    p.subtitle {
      text-align: center;
      margin-bottom: 30px;
      font-style: italic;
      color: #f5e6b3;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
      gap: 12px;
    }
    .day {
      background: #d4af37;
      color: #0b3c5d;
      border-radius: 12px;
      padding: 15px 0;
      text-align: center;
      cursor: pointer;
      font-weight: bold;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .day:hover {
      transform: scale(1.05);
      box-shadow: 0 0 10px rgba(212, 175, 55, 0.8);
    }
    .heart {
      position: fixed;
      color: #d4af37;
      font-size: 20px;
      animation: floatUp 2s ease-out forwards;
      pointer-events: none;
    }
    @keyframes floatUp {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to { opacity: 0; transform: translateY(-80px) scale(1.6); }
    }
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .modal-content {
      background: #0b3c5d;
      border-radius: 20px;
      padding: 30px;
      max-width: 500px;
      width: 100%;
      text-align: center;
      box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
    }
    .modal-content h2 {
      margin-top: 0;
    }
    .close {
      margin-top: 20px;
      background: #d4af37;
      color: #0b3c5d;
      border: none;
      padding: 10px 20px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Motivos que te amo e que é minha pessoa</h1>
    <p class="subtitle">Um motivo por dia para nunca esqueceres o quanto és amado</p>
    <div class="grid" id="days"></div>
  </div>  <div class="modal" id="modal">
    <div class="modal-content">
      <h2 id="modalDay"></h2>
      <p id="modalText"></p>
      <button class="close" onclick="closeModal()">Fechar</button>
    </div>
  </div>  <audio id="music" autoplay loop>
    <source src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_7b0fcb1b47.mp3?filename=romantic-piano-112191.mp3" type="audio/mpeg">
  </audio>  <script>
    const motivos = [];

    // EXEMPLO – depois você pode colar todos os 365 aqui
    for (let i = 1; i <= 365; i++) {
      if (i === 365) {
        motivos.push('Porque eu te amo. Simples assim.');
      } else {
        motivos.push(`Porque você é especial para mim (Motivo ${i}).`);
      }
    }

    const daysContainer = document.getElementById('days');

    for (let i = 1; i <= 365; i++) {
      const div = document.createElement('div');
      div.className = 'day';
      div.innerText = i;
      div.onclick = () => openModal(i);
      daysContainer.appendChild(div);
    }

    function createHeart(x, y) {
      const heart = document.createElement('div');
      heart.className = 'heart';
      heart.innerHTML = '❤';
      heart.style.left = x + 'px';
      heart.style.top = y + 'px';
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), 2000);
    }

    function openModal(day) {
      createHeart(window.innerWidth / 2, window.innerHeight / 2);(day) {
      document.getElementById('modalDay').innerText = `Dia ${day}`;
      document.getElementById('modalText').innerText = motivos[day - 1];
      document.getElementById('modal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('modal').style.display = 'none';
    }
  </script></body>
</html>
